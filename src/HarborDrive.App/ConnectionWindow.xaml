<Window x:Class="HarborDrive.App.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="S3 연결 설정 · HarborDrive" Width="680" Height="760" MinHeight="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="새로운 드라이브의 시작" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Amazon S3 또는 S3 호환 스토리지를 연결합니다." Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><TextBlock x:Name="ErrorText" Foreground="#A34F20" TextWrapping="Wrap" Margin="0,0,0,12" /><DockPanel><Button x:Name="SaveButton" Content="연결 저장" Style="{StaticResource Primary}" Click="Save_Click" DockPanel.Dock="Right" Margin="8,0,0,0" IsDefault="True" /><Button Content="취소" IsCancel="True" DockPanel.Dock="Right" Margin="8,0,0,0" /><TextBlock Text="인증 키는 Windows 계정으로 암호화됩니다." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></DockPanel></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="연결 이름" Style="{StaticResource Caption}" /><TextBox x:Name="NameBox" AutomationProperties.Name="연결 이름" Margin="0,0,0,16" />
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="리전" Style="{StaticResource Caption}" /><TextBox x:Name="RegionBox" AutomationProperties.Name="리전" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="드라이브 문자" Style="{StaticResource Caption}" /><ComboBox x:Name="LetterBox" AutomationProperties.Name="드라이브 문자" /></StackPanel></Grid>
      <TextBlock Text="Access Key ID" Style="{StaticResource Caption}" /><PasswordBox x:Name="AccessBox" AutomationProperties.Name="Access Key ID" Margin="0,0,0,14" />
      <TextBlock Text="Secret Access Key" Style="{StaticResource Caption}" /><PasswordBox x:Name="SecretBox" AutomationProperties.Name="Secret Access Key" Margin="0,0,0,14" />
      <Expander Header="임시 인증 토큰 / AWS 프로필" Margin="0,0,0,14"><StackPanel Margin="0,12,0,0"><TextBlock Text="Session Token (선택)" Style="{StaticResource Caption}" /><PasswordBox x:Name="TokenBox" AutomationProperties.Name="Session Token" /><CheckBox x:Name="EnvironmentBox" Content="AWS 기본 인증 체인 사용 (환경 변수 / AWS 프로필)" Checked="AuthChanged" Unchecked="AuthChanged" /><TextBox x:Name="AwsProfileBox" AutomationProperties.Name="AWS 프로필 이름" ToolTip="AWS 프로필 이름. 비워두면 기본 인증 체인을 사용합니다." /></StackPanel></Expander>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="버킷" Style="{StaticResource Caption}" /><TextBox x:Name="BucketBox" AutomationProperties.Name="버킷" /></StackPanel><Button Grid.Column="1" Content="버킷 찾기" Click="Buckets_Click" VerticalAlignment="Bottom" Margin="0" /></Grid>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="버킷 내 경로 (선택)" Style="{StaticResource Caption}" /><TextBox x:Name="PrefixBox" AutomationProperties.Name="버킷 내 경로" /></StackPanel><Button Grid.Column="1" Content="폴더 찾기" Click="Folders_Click" VerticalAlignment="Bottom" Margin="0" /></Grid>
      <Button x:Name="TestButton" Content="연결 확인 (읽기 전용 검사)" Click="Test_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />
      <Expander Header="S3 호환 엔드포인트 / 캐시 설정" Margin="0,0,0,12"><StackPanel Margin="0,14,0,0"><TextBlock Text="엔드포인트 (AWS S3는 비워둡니다)" Style="{StaticResource Caption}" /><TextBox x:Name="EndpointBox" AutomationProperties.Name="엔드포인트" /><CheckBox x:Name="PathStyleBox" Content="Path-style 요청 사용 (S3 호환 스토리지)" /><TextBlock Text="캐시 기준 폴더 (비우면 앱 데이터 폴더 사용)" Style="{StaticResource Caption}" /><TextBox x:Name="CacheRootBox" AutomationProperties.Name="캐시 기준 폴더" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="캐시 목표 (GB)" Style="{StaticResource Caption}" /><TextBox x:Name="CacheSizeBox" AutomationProperties.Name="캐시 목표 GB" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="최소 여유 (GB)" Style="{StaticResource Caption}" /><TextBox x:Name="FreeSizeBox" AutomationProperties.Name="최소 여유 GB" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="쓰기 지연 (초)" Style="{StaticResource Caption}" /><TextBox x:Name="WriteBackBox" AutomationProperties.Name="쓰기 지연 초" /></StackPanel></Grid><TextBlock Text="캐시 용량은 정리 목표입니다. 미전송·사용 중인 파일로 초과될 수 있으며 자동 삭제하지 않습니다." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8" /></StackPanel></Expander>
      <CheckBox x:Name="AutoMountBox" Content="앱 시작 시 이 드라이브 자동 연결" /><CheckBox x:Name="RestartBox" Content="엔진이 종료되면 자동 재연결" /><CheckBox x:Name="ReadOnlyBox" Content="읽기 전용으로 연결" />
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
