<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><AssemblyName>HarborDrive</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns the UI/DPI lifecycle; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>0.1.2</Version><Product>HarborDrive</Product>
    <ApplicationIcon>Assets/HarborDrive.ico</ApplicationIcon>
    <RcloneExecutable Condition="'$(RcloneExecutable)' == ''">../../tools/rclone.exe</RcloneExecutable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../HarborDrive.Core/HarborDrive.Core.csproj" /></ItemGroup>
  <ItemGroup><None Include="$(RcloneExecutable)" Link="tools/rclone.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(RcloneExecutable)')" /></ItemGroup>
  <ItemGroup><None Include="../../tools/RCLONE-LICENSE.txt" Link="tools/RCLONE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/*.ico" /><Resource Include="Assets/HarborDrive.png" /></ItemGroup>
</Project>
