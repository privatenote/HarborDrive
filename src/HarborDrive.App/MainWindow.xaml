<Window x:Class="HarborDrive.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HarborDrive" Width="1180" Height="820" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#142D3A" Padding="22,30,22,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="◒  HarborDrive" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="YOUR CLOUD, WITHIN REACH" Foreground="#86ADB9" FontSize="9" Margin="2,9,0,34" />
          <TextBlock Text="내 드라이브" Foreground="#96B5C2" FontSize="12" Margin="0,0,0,12" />
          <TextBlock Text="탐색기와 연결된 S3" Foreground="#668E9F" FontSize="11" Margin="0,0,0,20" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="백그라운드에서 안전하게" Foreground="#D0E1E7" FontSize="12" />
          <TextBlock Text="창을 닫아도 연결은 유지됩니다." Foreground="#87A6B4" FontSize="11" Margin="0,5,0,20" />
          <Button Content="⚙  설정" Click="Settings_Click" Background="#233F4E" Foreground="White" BorderThickness="0" Margin="0,0,0,8">
            <Button.ContextMenu><ContextMenu><MenuItem Header="현재 S3 연결 설정" Click="Edit_Click" /><MenuItem Header="추가 S3 연결…" Click="Add_Click" /><Separator /><MenuItem Header="로그 폴더 열기" Click="Logs_Click" /></ContextMenu></Button.ContextMenu>
          </Button>
          <Button Content="모든 연결 해제 후 종료" Click="Exit_Click" Background="Transparent" Foreground="#AFC8D2" BorderThickness="0" FontSize="11" Margin="0" />
          <TextBlock Text="v0.1.0  ·  Windows ARM64 / x64" Foreground="#678C9F" FontSize="10" Margin="0,18,0,0" />
        </StackPanel>
        <ListBox x:Name="DriveList" SelectionChanged="DriveList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,14" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBody" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#2A4B5B" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#234452" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="#9FC4D0" FontSize="11" Margin="0,7,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="34,30,34,28">
        <DockPanel Margin="0,0,0,24">
          <CheckBox x:Name="LoginStart" Content="Windows 로그인 시 실행" DockPanel.Dock="Right" Click="LoginStart_Click" FontSize="12" Foreground="{StaticResource Muted}" />
          <StackPanel><TextBlock Text="클라우드 드라이브" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="S3를 탐색기에서. 전송 상태는 한눈에." Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
        </DockPanel>
        <Border x:Name="DependencyBanner" Background="#FFF0D4" CornerRadius="7" Padding="14" Margin="0,0,0,16"><TextBlock x:Name="DependencyText" TextWrapping="Wrap" Foreground="#79551C" /></Border>
        <Border x:Name="EmptyCard" Style="{StaticResource Card}" Padding="36" Margin="0,0,0,20">
          <StackPanel><TextBlock Text="클라우드에 닿는 가장 익숙한 방법" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14" /><TextBlock Text="S3 버킷과 드라이브 문자를 연결하세요.&#10;파일을 열고 저장하면 백그라운드에서 S3로 전송합니다." Foreground="{StaticResource Muted}" LineHeight="25" /><Button Content="첫 번째 드라이브 연결하기  →" Click="Add_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,26,0,16" /><TextBlock Text="01   S3 인증 설정        02   버킷·경로 선택        03   드라이브 연결" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
        </Border>
        <StackPanel x:Name="Details" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
              <DockPanel><Border Background="#E5F3F2" CornerRadius="8" Padding="13" DockPanel.Dock="Left" Margin="0,0,16,0"><TextBlock x:Name="LetterText" Text="S:" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="NameText" FontSize="21" FontWeight="SemiBold" /><TextBlock x:Name="RemoteText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></DockPanel>
              <Border x:Name="StateBadge" Background="#EAF4F1" CornerRadius="6" Padding="12" Margin="0,20,0,18"><TextBlock x:Name="StateText" TextWrapping="Wrap" /></Border>
              <WrapPanel><Button x:Name="ConnectButton" Content="드라이브 연결" Style="{StaticResource Primary}" Click="Connect_Click" /><Button x:Name="DisconnectButton" Content="안전하게 해제" Click="Disconnect_Click" /><Button x:Name="OpenButton" Content="탐색기 열기  ↗" Click="Open_Click" /><Button x:Name="EditButton" Content="연결 설정" Click="Edit_Click" /></WrapPanel>
            </StackPanel>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="업로드 대기 / 진행" Style="{StaticResource Caption}" /><TextBlock x:Name="PendingText" Text="—" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="현재 엔진의 전송 대기열" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="전송 속도" Style="{StaticResource Caption}" /><TextBlock x:Name="SpeedText" Text="—" FontSize="26" FontWeight="SemiBold" /><TextBlock x:Name="TransferredText" Text="현재 연결 세션 기준" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="사용 중인 캐시" Style="{StaticResource Caption}" /><TextBlock x:Name="CacheText" Text="—" FontSize="26" FontWeight="SemiBold" /><TextBlock x:Name="CacheLimitText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0" /></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel><DockPanel><Button Content="지금 재시도" Click="Retry_Click" DockPanel.Dock="Right" Padding="12,6" FontSize="12" Margin="0" /><TextBlock Text="전송 대기열" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel><TextBlock x:Name="QueueHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,13,0,9" /><DataGrid x:Name="QueueGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F3" MaxHeight="170" Background="White" RowHeaderWidth="0" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="파일" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="85" /><DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="90" /><DataGridTextColumn Header="시도" Binding="{Binding Tries}" Width="50" /></DataGrid.Columns></DataGrid></StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel><DockPanel><Button Content="새로고침" Click="RefreshLog_Click" DockPanel.Dock="Right" Padding="10,5" FontSize="11" Margin="0" /><TextBlock Text="최근 로그" FontSize="16" FontWeight="SemiBold" /></DockPanel><TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="130" FontFamily="Consolas" FontSize="11" Background="#F6F8FA" BorderThickness="0" Margin="0,14,0,14" /><WrapPanel><Button Content="원격 목록 갱신" Click="Refresh_Click" FontSize="11" Padding="10,7" /><Button Content="캐시 폴더" Click="Cache_Click" FontSize="11" Padding="10,7" /><Button Content="캐시 보존 후 중지" Click="Pause_Click" FontSize="11" Padding="10,7" /><Button Content="연결 설정 삭제" Click="Delete_Click" FontSize="11" Padding="10,7" /></WrapPanel></StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Text="로컬 저장 완료와 S3 전송 완료는 다를 수 있습니다. 해제 전 사용 중인 파일을 닫아 주세요." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0" />
        <TextBlock x:Name="FooterText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
